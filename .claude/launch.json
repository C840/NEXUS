{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nexus-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "nexus-frontend",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "nexus-share",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/share.mjs"
      ],
      "port": 8000
    }
  ]
}
